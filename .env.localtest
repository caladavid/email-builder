# Build de producción para probar en local con el padre MiTienda (localhost:3000).
# Solo lo usa "npm run preview:local". El build real de producción NO carga este archivo.
VITE_ALLOWED_ORIGINS=http://localhost:3000

# Subidas (ZIP / imágenes) pasan por el proxy de "vite preview" (ver vite.config.ts):
# el servicio rechaza el origen localhost por CORS.
VITE_API_BASE=http://localhost:4173
PROXY_TARGET=https://services.celcom.cl
